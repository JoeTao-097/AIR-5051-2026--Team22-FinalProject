  <version>0.1.0</version>
  <description>Launch files, configs, and URDF for the UR5e ultrasound scanning system</description>

  <maintainer email="qc@todo.todo">qc</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
